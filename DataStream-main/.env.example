# Copy this file to .env and fill in values for local development (outside Docker).
# When running inside Docker Compose, these are set automatically via the compose file.

KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC_EVENTS=events
KAFKA_TOPIC_DLQ=events-dlq
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=ecommerce
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Event rate control (1000 to 100000 events/min)
EVENTS_PER_MINUTE=1000
# Batch size per tick (higher = more events pushed at once)
BATCH_SIZE=100
# Number of concurrent publish workers
WORKERS=8
GIN_MODE=debug
